# Copy this file to ".env" and fill in your own values.
# NEVER commit the real .env file.

# Port the API listens on
PORT=5000

# Local MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017/deadline_manager
# MongoDB Atlas (example format - use your own user, password and cluster):
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/deadline_manager?retryWrites=true&w=majority

# Allowed browser origin(s) for CORS (comma-separated). Vite dev server default:
CLIENT_ORIGIN=http://localhost:5173

# development | production
NODE_ENV=development
